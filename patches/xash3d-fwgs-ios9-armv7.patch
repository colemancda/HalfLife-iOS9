diff --git a/3rdparty/libbacktrace/wscript b/3rdparty/libbacktrace/wscript
index b6868df..9bb57e7 100644
--- a/3rdparty/libbacktrace/wscript
+++ b/3rdparty/libbacktrace/wscript
@@ -57,6 +57,10 @@
 char buf[100];
 int main(int argc, char **argv) { return readlink(argv[0], buf, sizeof(buf)); }'''
 
+FRAGMENT_UNWIND_BACKTRACE='''#include <unwind.h>
+static _Unwind_Reason_Code cb(struct _Unwind_Context *ctx, void *data) { return _URC_NO_REASON; }
+int main(void) { return _Unwind_Backtrace(cb, 0); }'''
+
 def options(opt):
 	pass
 
@@ -71,6 +75,11 @@ def configure(conf):
 		conf.env.DISABLE_LIBBACKTRACE = True
 		return
 
+	# e.g. armv7 iOS, which only has the SjLj unwinder
+	if not conf.check_cc(fragment=FRAGMENT_UNWIND_BACKTRACE, msg='Checking for _Unwind_Backtrace', mandatory=False):
+		conf.env.DISABLE_LIBBACKTRACE = True
+		return
+
 	if not conf.path.find_dir('libbacktrace') or not conf.path.find_dir('libbacktrace/config'):
 		conf.fatal('Can\'t find libbacktrace submodule. Run `git submodule update --init --recursive`.')
 		return
